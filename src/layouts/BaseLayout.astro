---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { seo } from '../config/seo';
import { site } from '../config/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  currentSection?: string;
}

const {
  title = seo.defaultTitle,
  description = seo.defaultDescription,
  path = Astro.url.pathname,
  currentSection = 'home',
} = Astro.props;

const pageTitle = title === site.title ? title : seo.titleTemplate.replace('%s', title);
const canonical = new URL(path, seo.canonicalBaseUrl).toString();
const image = new URL(seo.defaultImage, seo.canonicalBaseUrl).toString();
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
  </head>
  <body>
    <div class="background-layer" aria-hidden="true"></div>
    <div class="page-shell">
      <Header currentSection={currentSection} />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
