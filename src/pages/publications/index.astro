---
import SectionHeading from '../../components/SectionHeading.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pageMetadata } from '../../config/seo';
import { profile } from '../../data/profile';
---

<BaseLayout
  title={pageMetadata.publications.title}
  description={pageMetadata.publications.description}
  path={pageMetadata.publications.path}
  currentSection="publications"
>
  <section class="page-section">
    <SectionHeading
      eyebrow="Research output"
      title="Publications"
    />

    <div class="info-grid">
      <section>
        <h2>Papers</h2>
        <ol class="publication-list">
          {profile.publications.map((publication) => (
            <li>
              {publication.authors} "{publication.title}." <em>{publication.venue}</em>, {publication.year}.
            </li>
          ))}
        </ol>
      </section>

      <section>
        <h2>Patents</h2>
        <ul>
          {profile.patents.map((patent) => <li>{patent}</li>)}
        </ul>
      </section>
    </div>
  </section>
</BaseLayout>
