---
import SectionHeading from '../../components/SectionHeading.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pageMetadata } from '../../config/seo';
import { profile } from '../../data/profile';

const highlightedAuthor = 'Qiu, B.';

const splitHighlightedAuthor = (authors: string) => {
  const index = authors.indexOf(highlightedAuthor);
  if (index === -1) {
    return { before: authors, match: '', after: '' };
  }

  return {
    before: authors.slice(0, index),
    match: highlightedAuthor,
    after: authors.slice(index + highlightedAuthor.length),
  };
};

const formatVolumeIssue = (volume?: string, issue?: string) => {
  if (!volume) return '';
  return issue ? `${volume}(${issue})` : volume;
};
---

<BaseLayout
  title={pageMetadata.publications.title}
  description={pageMetadata.publications.description}
  path={pageMetadata.publications.path}
  currentSection="publications"
>
  <section class="page-section">
    <SectionHeading
      eyebrow="Research output"
      title="Publications"
    />

    <div class="info-grid full-width-content">
      <section>
        <h2>Papers</h2>
        <ol class="publication-list">
          {profile.publications.map((publication) => {
            const authors = splitHighlightedAuthor(publication.authors);
            const volumeIssue = formatVolumeIssue(publication.volume, publication.issue);
            return (
              <li>
                {authors.match ? <>{authors.before}<strong>{authors.match}</strong>{authors.after}</> : publication.authors} ({publication.year}). {publication.title}.{' '}
                {publication.type === 'conference' ? (
                  <>
                    In <em>{publication.venue}</em>{publication.location ? `, ${publication.location}` : ''}{publication.pages ? `, pp. ${publication.pages}` : ''}.
                  </>
                ) : (
                  <>
                    <em>{publication.venue}</em>{volumeIssue ? `, ${volumeIssue}` : ''}{publication.pages ? `, ${publication.pages}` : ''}.
                  </>
                )}
                {publication.doi ? <> <a href={`https://doi.org/${publication.doi}`}>https://doi.org/{publication.doi}</a></> : null}
              </li>
            );
          })}
        </ol>
      </section>

      <section>
        <h2>Patents</h2>
        <ul>
          {profile.patents.map((patent) => <li>{patent}</li>)}
        </ul>
      </section>
    </div>
  </section>
</BaseLayout>
