---
import SectionHeading from '../components/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageMetadata } from '../config/seo';
import { externalLinks } from '../config/site';

const links = Object.entries(externalLinks).filter(([, value]) => value);
const labels: Record<string, string> = {
  email: externalLinks.email.replace('mailto:', ''),
};
---

<BaseLayout
  title={pageMetadata.contact.title}
  description={pageMetadata.contact.description}
  path={pageMetadata.contact.path}
  currentSection="contact"
>
  <section class="page-section">
    <SectionHeading
      eyebrow="Contact"
      title="Contact"
      description="For academic or professional contact, please use the public email below."
    />

    {
      links.length > 0 ? (
        <ul class="contact-list">
          {links.map(([label, href]) => (
            <li><a href={href as string}>{labels[label] || label}</a></li>
          ))}
        </ul>
      ) : (
        <p class="reserved-note">No public contact links are listed yet.</p>
      )
    }
  </section>
</BaseLayout>
