---
import SectionHeading from '../../components/SectionHeading.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pageMetadata } from '../../config/seo';
import { profile } from '../../data/profile';

const projects = [...profile.projectExperience, ...profile.workExperience].sort(
  (a, b) => Number.parseInt(b.startYear, 10) - Number.parseInt(a.startYear, 10),
);
---

<BaseLayout
  title={pageMetadata.projects.title}
  description={pageMetadata.projects.description}
  path={pageMetadata.projects.path}
  currentSection="projects"
>
  <section class="page-section">
    <SectionHeading
      eyebrow="Research and engineering"
      title="Projects"
      description="Selected project experience across robotics, automation, motion control, and mechanical behavior analysis."
    />

    <div class="timeline-list">
      {projects.map((project) => (
        <article class="timeline-item">
          <p class="article-meta">
            {project.startYear}-{project.endYear} · {project.location}
          </p>
          <h2>{project.title}</h2>
          <p><strong>{project.organization}</strong></p>
          <p>{project.summary}</p>
          <ul>
            {project.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
