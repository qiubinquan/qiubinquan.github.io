---
import SectionHeading from '../../components/SectionHeading.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pageMetadata } from '../../config/seo';

const newsItems = [
  {
    date: '2026 May',
    text: 'I gave research presentations at the JpGU-AGU Joint Meeting 2026, held from May 27 to May 30 at Makuhari Messe in Chiba.',
  },
  {
    date: '2025 Oct.',
    text: 'I joined the Complex Systems Science Laboratory at Hiroshima University as a doctoral student.',
  },
  {
    date: '2025 Oct.',
    text: "I was selected as a SPRING fellow in Hiroshima University's Program for Developing and Supporting the Next-Generation of Innovative Researchers.",
  },
];
---

<BaseLayout
  title={pageMetadata.news.title}
  description={pageMetadata.news.description}
  path={pageMetadata.news.path}
  currentSection="news"
>
  <section class="page-section">
    <SectionHeading
      eyebrow="Updates"
      title="News"
    />

    <ul class="news-list">
      {newsItems.map((item) => (
        <li>
          <strong>{item.date}</strong>
          <span>{item.text}</span>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
