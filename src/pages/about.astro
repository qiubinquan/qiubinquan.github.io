---
import SectionHeading from '../components/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageMetadata } from '../config/seo';
import { externalLinks } from '../config/site';
import { profile } from '../data/profile';

const email = externalLinks.email.replace('mailto:', '');
---

<BaseLayout
  title={pageMetadata.about.title}
  description={pageMetadata.about.description}
  path={pageMetadata.about.path}
  currentSection="about"
>
  <section class="page-section">
    <SectionHeading
      eyebrow="Profile"
      title="About"
      description={profile.bio || 'A concise academic profile can be added here when public details are ready.'}
    />

    <div class="info-grid">
      <section>
        <h2>Affiliation</h2>
        <p>{profile.affiliation || 'To be added.'}</p>
      </section>
      <section>
        <h2>Location</h2>
        <p>{profile.location || 'To be added.'}</p>
      </section>
      <section>
        <h2>Contact</h2>
        {email ? <p><a href={externalLinks.email}>{email}</a></p> : <p>To be added.</p>}
      </section>
      <section>
        <h2>Interests</h2>
        {
          profile.interests.length > 0 ? (
            <ul>
              {profile.interests.map((item) => <li>{item}</li>)}
            </ul>
          ) : (
            <p>To be added.</p>
          )
        }
      </section>
      <section>
        <h2>Education</h2>
        {
          profile.education.length > 0 ? (
            <ul>
              {profile.education.map((item) => (
                <li>
                  {item.degree}, {item.field}, {item.institution} ({item.startYear}-{item.endYear})
                </li>
              ))}
            </ul>
          ) : (
            <p>To be added.</p>
          )
        }
      </section>
      <section>
        <h2>Project Experience</h2>
        {
          profile.projectExperience.length > 0 ? (
            <div class="timeline-list">
              {profile.projectExperience.map((item) => (
                <article class="timeline-item">
                  <p class="card-meta">{item.startYear}-{item.endYear} | {item.location}</p>
                  <h3>{item.title}</h3>
                  <p>{item.organization}</p>
                  <p>{item.summary}</p>
                  <ul>
                    {item.highlights.map((highlight) => <li>{highlight}</li>)}
                  </ul>
                </article>
              ))}
            </div>
          ) : (
            <p>To be added.</p>
          )
        }
      </section>
      <section>
        <h2>Work Experience</h2>
        {
          profile.workExperience.length > 0 ? (
            <div class="timeline-list">
              {profile.workExperience.map((item) => (
                <article class="timeline-item">
                  <p class="card-meta">{item.startYear}-{item.endYear} | {item.location}</p>
                  <h3>{item.title}</h3>
                  <p>{item.organization}</p>
                  <p>{item.summary}</p>
                  <ul>
                    {item.highlights.map((highlight) => <li>{highlight}</li>)}
                  </ul>
                </article>
              ))}
            </div>
          ) : (
            <p>To be added.</p>
          )
        }
      </section>
      <section>
        <h2>Publications</h2>
        {
          profile.publications.length > 0 ? (
            <ol class="publication-list">
              {profile.publications.map((item) => (
                <li>
                  {item.authors} "{item.title}." <em>{item.venue}</em>, {item.year}.
                </li>
              ))}
            </ol>
          ) : (
            <p>To be added.</p>
          )
        }
      </section>
      <section>
        <h2>Patents</h2>
        {
          profile.patents.length > 0 ? (
            <ul>
              {profile.patents.map((item) => <li>{item}</li>)}
            </ul>
          ) : (
            <p>To be added.</p>
          )
        }
      </section>
      <section>
        <h2>Honors and Awards</h2>
        {
          profile.awards.length > 0 ? (
            <ul>
              {profile.awards.map((item) => <li>{item}</li>)}
            </ul>
          ) : (
            <p>To be added.</p>
          )
        }
      </section>
      <section>
        <h2>Skills</h2>
        {
          profile.skills.length > 0 ? (
            <ul>
              {profile.skills.map((group) => <li>{group.name}: {group.items.join(', ')}</li>)}
            </ul>
          ) : (
            <p>To be added.</p>
          )
        }
      </section>
    </div>
  </section>
</BaseLayout>
