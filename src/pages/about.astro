---
import SectionHeading from '../components/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageMetadata } from '../config/seo';
import { profile } from '../data/profile';
---

<BaseLayout
  title={pageMetadata.about.title}
  description={pageMetadata.about.description}
  path={pageMetadata.about.path}
  currentSection="about"
>
  <section class="page-section">
    <SectionHeading
      eyebrow="Profile"
      title="About"
    />

    <div class="info-grid">
      <section>
        <h2>Research Interests</h2>
        {
          profile.interests.length > 0 ? (
            <ul>
              {profile.interests.map((item) => <li>{item}</li>)}
            </ul>
          ) : (
            <p>To be added.</p>
          )
        }
      </section>
      <section>
        <h2>Education</h2>
        {
          profile.education.length > 0 ? (
            <ul>
              {profile.education.map((item) => (
                <li>
                  <strong>{item.degree}</strong>{item.field ? ` in ${item.field}` : ''}, {item.institution}, {item.startYear}-{item.endYear}
                </li>
              ))}
            </ul>
          ) : (
            <p>To be added.</p>
          )
        }
      </section>
      <section>
        <h2>Work Experience</h2>
        {
          profile.workExperience.length > 0 ? (
            <ul>
              {profile.workExperience.map((item) => (
                <li>
                  <strong>{item.title}</strong>, {item.organization} ({item.startYear}-{item.endYear})
                </li>
              ))}
            </ul>
          ) : (
            <p>To be added.</p>
          )
        }
      </section>
      <section>
        <h2>Honors and Awards</h2>
        {
          profile.awards.length > 0 ? (
            <ul>
              {profile.awards.map((item) => {
                const [award, ...details] = item.split(', ');
                const shouldEmphasize = !item.endsWith('2017') && !item.endsWith('2016');
                return (
                  <li>{shouldEmphasize ? <strong>{award}</strong> : award}{details.length > 0 ? `, ${details.join(', ')}` : ''}</li>
                );
              })}
            </ul>
          ) : (
            <p>To be added.</p>
          )
        }
      </section>
      <section>
        <h2>Skills</h2>
        {
          profile.skills.length > 0 ? (
            <ul>
              {profile.skills.map((group) => <li>{group.name}: {group.items.join(', ')}</li>)}
            </ul>
          ) : (
            <p>To be added.</p>
          )
        }
      </section>
    </div>
  </section>
</BaseLayout>
