---
import SectionHeading from '../components/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageMetadata } from '../config/seo';
import { externalLinks } from '../config/site';
import { profile } from '../data/profile';
---

<BaseLayout
  title={pageMetadata.about.title}
  description={pageMetadata.about.description}
  path={pageMetadata.about.path}
  currentSection="about"
>
  <section class="page-section">
    <SectionHeading
      eyebrow="Profile"
      title="About"
    />

    <div class="info-grid">
      <section>
        <h2>Affiliation</h2>
        <p class="affiliation-lines">
          <span><a href={externalLinks.cssLab}>Complex Systems Science Laboratory</a></span>
          <span>Graduate School of Advanced Science and Engineering</span>
          <span>Hiroshima University</span>
        </p>
      </section>
      <section>
        <h2>Interests</h2>
        {
          profile.interests.length > 0 ? (
            <ul>
              {profile.interests.map((item) => <li>{item}</li>)}
            </ul>
          ) : (
            <p>To be added.</p>
          )
        }
      </section>
      <section>
        <h2>Education</h2>
        {
          profile.education.length > 0 ? (
            <ul>
              {profile.education.map((item) => (
                <li>
                  {item.degree}{item.field ? ` in ${item.field}` : ''}, {item.institution}, {item.startYear}-{item.endYear}
                </li>
              ))}
            </ul>
          ) : (
            <p>To be added.</p>
          )
        }
      </section>
      <section>
        <h2>Work Experience</h2>
        {
          profile.workExperience.length > 0 ? (
            <ul>
              {profile.workExperience.map((item) => (
                <li>
                  {item.title}, {item.organization} ({item.startYear}-{item.endYear})
                </li>
              ))}
            </ul>
          ) : (
            <p>To be added.</p>
          )
        }
      </section>
      <section>
        <h2>Honors and Awards</h2>
        {
          profile.awards.length > 0 ? (
            <ul>
              {profile.awards.map((item) => <li>{item}</li>)}
            </ul>
          ) : (
            <p>To be added.</p>
          )
        }
      </section>
      <section>
        <h2>Skills</h2>
        {
          profile.skills.length > 0 ? (
            <ul>
              {profile.skills.map((group) => <li>{group.name}: {group.items.join(', ')}</li>)}
            </ul>
          ) : (
            <p>To be added.</p>
          )
        }
      </section>
    </div>
  </section>
</BaseLayout>
