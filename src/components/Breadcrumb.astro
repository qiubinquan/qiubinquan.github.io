---
import type { LinkItem } from '../types/content';

interface Props {
  items: LinkItem[];
}

const { items } = Astro.props;
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol>
    {
      items.map((item, index) => (
        <li>
          {index < items.length - 1 ? <a href={item.url}>{item.label}</a> : <span>{item.label}</span>}
        </li>
      ))
    }
  </ol>
</nav>
