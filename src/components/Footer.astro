---
import { externalLinks, site } from '../config/site';

const links = Object.entries(externalLinks).filter(([, value]) => value);
const year = new Date().getFullYear();
const labels: Record<string, string> = {
  email: 'Email',
  github: 'GitHub',
  googleScholar: 'Google Scholar',
  linkedin: 'LinkedIn',
  orcid: 'ORCID',
  cv: 'CV',
};
---

<footer class="site-footer">
  <p>&copy; {year} {site.name}</p>
  {
    links.length > 0 && (
      <nav class="footer-links" aria-label="External links">
        {links.map(([label, href]) => (
          <a href={href as string}>{labels[label] || label}</a>
        ))}
      </nav>
    )
  }
</footer>
